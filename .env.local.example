# Get your key at https://openrouter.ai/keys
# This stays on the server only. Never prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: maximum USD price per 1K tokens (prompt or completion, whichever
# is higher) that a model is allowed to charge. The cascade only considers
# models whose listed pricing is at or below this cap on BOTH prompt and
# completion. Default "0" keeps the strict "both prompt and completion
# must be 0" behavior. Set to e.g. "0.0001" to include near-free models.
# OPENROUTER_MAX_PRICE_PER_1K=0

# Optional: pin a single specific model id, bypassing the catalog filter
# entirely. Useful when the free catalog is empty.
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
